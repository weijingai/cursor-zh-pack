{
  "name": "cursor-zh-pack",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Simplified Chinese overlay and installer for Cursor-specific UI (Settings, Agents Window, menus).",
  "author": "weijingai",
  "homepage": "https://github.com/weijingai/cursor-zh-pack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weijingai/cursor-zh-pack.git"
  },
  "bugs": {
    "url": "https://github.com/weijingai/cursor-zh-pack/issues"
  },
  "keywords": [
    "cursor",
    "i18n",
    "zh-cn",
    "simplified-chinese",
    "language-pack"
  ],
  "scripts": {
    "extract": "node tools/extract-cursor-modules.mjs",
    "recover": "node tools/recover-official.mjs",
    "review": "node tools/review.mjs",
    "assemble": "node tools/assemble.mjs && node tools/build-language-pack.mjs",
    "build-language-pack": "node tools/build-language-pack.mjs",
    "sync-hardcoded": "node tools/sync-hardcoded.mjs",
    "deploy": "node installer/lib/zh-pack.cjs install --payload translations/main.i18n.json",
    "restore": "node installer/lib/zh-pack.cjs uninstall",
    "restart": "node installer/lib/zh-pack.cjs restart",
    "verify": "node tools/verify-nls.cjs",
    "build": "node tools/assemble.mjs && node tools/sync-hardcoded.mjs && node tools/build-installer.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "installer",
    "payload",
    "translations",
    "glossary",
    "catalog",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
